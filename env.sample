# Application
PORT=5011
RELEASE_SHA=development
DB_URL=postgresql+psycopg2://fastcpi:change-me@localhost:5432/fastcpi
DB_SCHEMA=fastcpi
APP_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-an-independent-long-random-value
LOGIN=1
INVITE_ONLY=0
CORS_ALLOWED_ORIGINS=https://cpi.fastsme.com

# Discovery and agent providers
EXA_API_KEY=
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google authorization-code OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cpi.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Account administration and email
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com
FROM_NAME=FastCPI

# Daily watchlists
WATCHLIST_SCANS_ENABLED=1
WATCHLIST_SCAN_INTERVAL_SECONDS=3600
DIGEST_ENABLED=0
